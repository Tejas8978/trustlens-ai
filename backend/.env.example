# Copy this file to .env and fill in your values.

# MongoDB connection string
# - Local:          mongodb://localhost:27017
# - MongoDB Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trustlens?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trustlens?retryWrites=true&w=majority

# MongoDB database name (default: trustlens)
MONGO_DB_NAME=trustlens

# Allowed CORS origins (comma-separated). Use * to allow all.
ALLOWED_ORIGINS=*

# Optional: External High-Accuracy Deepfake & GenAI Vision API (Sightengine)
# If provided, TrustLens AI will query Sightengine for 98%+ cloud forensic verification.
# If omitted, TrustLens AI runs 100% locally with 2D FFT, local ML, biometric, and ELA forensics.
# SIGHTENGINE_API_USER=your_user_id_here
# SIGHTENGINE_API_SECRET=your_api_secret_here

# Optional: Custom Deepfake Microservice endpoint
# DEEPFAKE_API_ENDPOINT=https://your-custom-ai-detector.example.com/predict
# DEEPFAKE_API_KEY=your_key_here

# Optional: Google Safe Browsing API v4 for Real-Time Threat Intelligence
# If provided, URLs are validated against Google's live global phishing/malware database.
# GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_api_key_here

# Optional: Hugging Face Inference API for Deepfake Vision & BERT NLP Spam Detection
# Models used: umm-maybe/AI-image-detector (Vision) and mrm8488/bert-tiny-finetuned-sms-spam-detection (NLP)
# HUGGINGFACE_API_KEY=your_hf_token_here

# Optional: Custom NLP Microservice for Scam/Phishing Detection
# NLP_API_ENDPOINT=https://your-custom-nlp.example.com/analyze
# NLP_API_KEY=your_key_here
