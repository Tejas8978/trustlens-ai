# Copy this file to .env and fill in your values.

# MongoDB connection string
# - Local:          mongodb://localhost:27017
# - MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trustlens

# MongoDB database name (default: trustlens)
MONGO_DB_NAME=trustlens

# Allowed CORS origins (comma-separated). Use * to allow all.
ALLOWED_ORIGINS=*
